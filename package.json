{
  "name": "med-assurance",
  "version": "0.1.0",
  "description": "Automobile insurance claim management for Moroccan brokers: demo sandbox, scoped broker workspace with claims, tasks, notes and audit, plus a client declaration portal.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/READMEmaybe/med-assurance.git"
  },
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "env:check": "tsx scripts/check-env.ts",
    "supabase:check": "tsx scripts/check-supabase.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:types": "node scripts/generate-db-types.mjs",
    "deploy:preview": "npx --yes vercel@59.23.2 deploy",
    "deploy:production": "npx --yes vercel@59.23.2 deploy --prod",
    "dev:local": "node scripts/with-local-supabase.mjs npm run dev",
    "build:local": "node scripts/with-local-supabase.mjs npm run build",
    "test:e2e:local": "node scripts/with-local-supabase.mjs npm run test:e2e",
    "db:test": "node scripts/test-access.mjs",
    "db:seed:generate": "node scripts/generate-demo-seed.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "supabase": true,
    "@tailwindcss/oxide": true,
    "@swc/core": true,
    "unrs-resolver": true
  }
}
