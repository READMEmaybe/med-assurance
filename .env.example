# Copy to .env.local. Use a dedicated development/preview Supabase project.
# Public values are bundled at build time; rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# DeepSeek is introduced in M9. No server/admin keys are needed in M1.
